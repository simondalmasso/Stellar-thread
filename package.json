{
  "name": "stellar-thread",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test:core": "rm -rf .build-core && tsc -p tsconfig.core.json && node --test tests/core.test.mjs",
    "test:python": "python -m unittest discover -s listener -p 'test_*.py' -v",
    "test:e2e": "playwright test",
    "test": "npm run test:core && npm run test:python",
    "audit:secrets": "node scripts/secret-scan.mjs",
    "licenses": "node scripts/license-inventory.mjs",
    "deploy": "npm run build && wrangler deploy",
    "build:manifest": "node scripts/build-manifest.mjs",
    "test:worker": "node tests/worker-smoke.mjs",
    "catalog:refresh": "node scripts/update-target-catalog.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.4",
    "@react-three/fiber": "^9.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.2",
    "wrangler": "^4.28.1"
  }
}
