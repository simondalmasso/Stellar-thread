{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stellar-thread",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "production",
    "ALLOW_PHYSICAL_TRANSMISSION": "false"
  }
}
